# HTTPS without buying a domain: DOMAIN=<EC2-public-IP-with-dashes>.sslip.io (e.g. 34-210-12-7.sslip.io)
{$DOMAIN} {
	encode gzip

	@backend path /api/* /media/*
	handle @backend {
		# flush immediately: MJPEG and WebSocket stream through here
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# WebRTC (WHEP) for the face-blurred *_view streams; MediaMTX itself only lets browsers read *_view paths
	handle_path /webrtc/* {
		reverse_proxy mediamtx:8889
	}

	handle {
		respond "Nazar API is running. Open the web app (Amplify URL)." 200
	}
}
